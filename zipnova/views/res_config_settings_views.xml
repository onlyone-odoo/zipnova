<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.zipnova</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sale_shipping_setting_container']" position="inside">
                <setting
                    id="zipnova_connector"
                    string="Zipnova"
                    help="Quote, create and track shipments with Zipnova (formerly Zippin)."
                    company_dependent="1"
                >
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="zipnova_id" class="col-lg-4 o_light_label"/>
                            <field name="zipnova_id"/>
                        </div>
                        <div class="row">
                            <label for="zipnova_key" class="col-lg-4 o_light_label"/>
                            <field name="zipnova_key" password="True"/>
                        </div>
                        <div class="row">
                            <label for="zipnova_secret" class="col-lg-4 o_light_label"/>
                            <field name="zipnova_secret" password="True"/>
                        </div>
                        <div class="row">
                            <label for="zipnova_origin_id" class="col-lg-4 o_light_label"/>
                            <field name="zipnova_origin_id"/>
                        </div>
                        <div class="row">
                            <label for="zipnova_source" class="col-lg-4 o_light_label"/>
                            <field name="zipnova_source"/>
                        </div>
                        <div class="row">
                            <label for="zipnova_declared_value" class="col-lg-4 o_light_label"/>
                            <field name="zipnova_declared_value"/>
                        </div>
                    </div>
                    <div class="mt8">
                        <button
                            name="%(delivery.action_delivery_carrier_form)d"
                            type="action"
                            class="btn-link"
                            icon="oi-arrow-right"
                            string="Shipping Methods"
                        />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
