<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="delivery_carrier_form_view" model="ir.ui.view">
        <field name="name">delivery.carrier.zipnova.form</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="is_free"/>
            </field>
            <notebook position="inside">
                <page
                    name="page_zipnova"
                    string="Zipnova"
                    invisible="delivery_type != 'zipnova'"
                >
                    <group>
                        <group>
                            <field
                                name="zipnova_shipment_type"
                                required="delivery_type == 'zipnova'"
                            />
                            <field name="zipnova_shipment_type_is_pickup"/>
                            <field name="fixed_margin_time"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
