<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_choose_delivery_carrier_form_zipnova" model="ir.ui.view">
        <field name="name">choose.delivery.carrier.form.zipnova</field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='carrier_id']" position="after">
                <field name="zipnova_pickup_view_invisible" invisible="1"/>
                <field name="zipnova_pickup_view_id" invisible="1"/>
                <field
                    name="zipnova_pickup"
                    invisible="zipnova_pickup_view_invisible"
                    domain="[('carrier_id', '=', zipnova_pickup_view_id), ('order_id', '=', order_id)]"
                />
            </xpath>
            <xpath expr="//button[@name='update_price']/.." position="after">
                <label for="zipnova_estimated_delivery" invisible="delivery_type != 'zipnova'"/>
                <div class="o_row" invisible="delivery_type != 'zipnova'">
                    <field name="zipnova_estimated_delivery" readonly="1"/>
                    <button name="set_only_the_date" type="object" string="Save date"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
