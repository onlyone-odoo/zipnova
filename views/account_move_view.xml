<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_zipnova" model="ir.ui.view">
        <field name="name">account.move.form.zipnova</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']" position="after">
                <group string="Zipnova" name="zipnova_info_group">
                    <field name="zipnova_shipping_tracking_external" readonly="1" widget="url"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
