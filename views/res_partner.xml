<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_zipnova" model="ir.ui.view">
        <field name="name">res.partner.form.zipnova</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='street']" position="attributes">
                <attribute name="placeholder">Ej: Avenida Siempreviva 742</attribute>
            </xpath>
            <xpath expr="//field[@name='street2']" position="attributes">
                <attribute name="placeholder">Ej: 201</attribute>
            </xpath>
        </field>
    </record>
</odoo>
