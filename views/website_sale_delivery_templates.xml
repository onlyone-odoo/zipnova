<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="delivery_method_zipnova" inherit_id="website_sale.delivery_method">
        <xpath expr="//div[@name='o_pickup_location']" position="after">
            <t t-if="dm.delivery_type == 'zipnova' and dm.zipnova_shipment_type_is_pickup">
                <select
                    t-att-name="'zipnova_pickup_%s' % dm.id"
                    t-att-id="'zipnova_pickup_%s' % dm.id"
                    class="form-select mt-3 mb-3 zipnova-pickup-select"
                    t-att-data-delivery-carrier-id="dm.id"
                    t-att-data-zipnova-carrier-id="dm.zipnova_shipment_type"
                >
                    <option value="">Select a pickup point</option>
                </select>
            </t>
        </xpath>
    </template>
</odoo>
